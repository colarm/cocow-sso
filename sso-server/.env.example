# SSO Server 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================
DB_PASSWORD=your_mysql_password_here

# ============================================
# JWT 密钥配置（必填）
# ============================================
# 使用 ./scripts/generate-rsa-keys.sh 生成密钥对
# 然后将生成的 .env.jwt 内容复制到这里

# RSA 私钥（PKCS#8 格式，去除换行符）
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----MIIEvQIBADANBgkq...-----END PRIVATE KEY-----

# RSA 公钥（X.509 格式，去除换行符）
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----MIIBIjANBgkqhkiG...-----END PUBLIC KEY-----

# 密钥 ID（用于 JWKS 和 JWT header，可选）
JWT_KID=rsa-key-20260208

# JWT Issuer（可选，默认: https://sso.cocow.site）
JWT_ISSUER=https://sso.cocow.site

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=

# ============================================
# Spring 管理员密码
# ============================================
ADMIN_PASSWORD=admin

# ============================================
# SSL 配置（生产环境）
# ============================================
# SSL_KEYSTORE_PASSWORD=your_keystore_password
