# cocow-sso Environment Variables
#
# Usage:
#   cp .env.example .env
#   # Fill in the values below, then:
#   cat sso-server/.env.jwt >> .env   # append generated JWT keys
#
# Generate JWT keys (run once on the server):
#   cd sso-server && chmod +x scripts/generate-rsa-keys.sh && ./scripts/generate-rsa-keys.sh

# ============================================
# Database (MySQL)
# ============================================
DB_PASSWORD=your_strong_mysql_password_here

# ============================================
# Redis
# ============================================
# Leave empty to disable Redis auth (not recommended for production)
REDIS_PASSWORD=

# ============================================
# JWT Keys  (generated by scripts/generate-rsa-keys.sh)
# Paste the single-line values output by the script here.
# ============================================
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
JWT_KID=rsa-key-20260309
JWT_ISSUER=https://sso.cocow.site

# ============================================
# Spring / Admin
# ============================================
# Password for the built-in admin account (change before going live)
ADMIN_PASSWORD=change_me_before_production
